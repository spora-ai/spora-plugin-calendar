includes:
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    paths:
        - src
        - tests
    level: 5
    excludePaths:
        - vendor
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        # TODO(spora-core): Remove once `spora-ai/spora-core` releases the
        # new `bool|array $required` signature on `#[ToolParameter]` (see
        # https://github.com/spora-ai/spora-core/pull/165 — the per-op form
        # currently trips PHPStan against the Packagist version still using
        # `bool $required`). The rewrites themselves are correct; they will
        # resolve cleanly the moment the plugin's `composer.json` constraint
        # bumps to a release that contains the changes.
        -
            identifier: argument.type
            path: src/Tools
